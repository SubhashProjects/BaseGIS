VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional XYZ basemap URL templates (use a provider whose terms permit your use)
VITE_MAP_TILE_ROADMAP=
VITE_MAP_TILE_SATELLITE=
VITE_MAP_TILE_HYBRID=
VITE_MAP_TILE_TERRAIN=
VITE_MAP_TILE_ROADS=
VITE_MAP_TILE_OSM=

# Server-side only: configure as an Edge Function secret, never as a VITE_ variable
# POWERGIS_BACKUP_CRON_SECRET=
# POWERGIS_MAX_IMPORT_BYTES=52428800
# POWERGIS_MAX_IMPORT_FEATURES=50000

# Supabase Edge Function secrets (never add these to VITE_ variables):
# POWERGIS_BACKUP_BUCKET=powergis-backups
# POWERGIS_BACKUP_CRON_SECRET=
# POWERGIS_BACKUP_MAX_ROWS=250000
# POWERGIS_BACKUP_RESTORE_MAX_BYTES=268435456
# POWERGIS_ALLOWED_ORIGIN=https://your-approved-powergis-origin.example
# POWERGIS_BACKUP_ENCRYPTION_KEY=<base64url-encoded 32-byte random key; server-side only>
